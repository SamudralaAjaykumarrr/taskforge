# Copy to .env (or export directly) before running cmd/api or cmd/worker.

# Required. Points at the PostgreSQL instance started by docker-compose.yml,
# or any PostgreSQL 13+ instance.
TASKFORGE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/taskforge?sslmode=disable

# Optional. Defaults shown.
TASKFORGE_HTTP_ADDR=:8080
TASKFORGE_WORKER_POLL_INTERVAL=500ms
