# Copy to .env (or export directly) before running cmd/api or cmd/worker.

# Required. Points at the PostgreSQL instance started by docker-compose.yml,
# or any PostgreSQL 13+ instance.
TASKFORGE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/taskforge?sslmode=disable

# Optional. Defaults shown.
TASKFORGE_HTTP_ADDR=:8080
TASKFORGE_WORKER_POLL_INTERVAL=500ms

# Phase 8 (observability). Defaults shown. TASKFORGE_METRICS_ADDR is
# cmd/worker's standalone GET /metrics listener (cmd/api instead serves
# /metrics on TASKFORGE_HTTP_ADDR above); set it to an empty string to
# disable it. TASKFORGE_ACTIVE_WORKER_WINDOW bounds "recent" for the
# taskforge_active_workers gauge -- see docs/observability.md.
TASKFORGE_METRICS_ADDR=:9090
TASKFORGE_ACTIVE_WORKER_WINDOW=30s
