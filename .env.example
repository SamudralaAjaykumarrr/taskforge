# Copy to .env (or export directly) before running cmd/api or cmd/worker.

# Required. Points at the PostgreSQL instance started by docker-compose.yml,
# or any PostgreSQL 13+ instance.
TASKFORGE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/taskforge?sslmode=disable

# Optional. Defaults shown.
TASKFORGE_HTTP_ADDR=:8080
TASKFORGE_WORKER_POLL_INTERVAL=500ms

# Phase 8 (observability). Defaults shown. TASKFORGE_METRICS_ADDR is
# cmd/worker's standalone GET /metrics listener (cmd/api instead serves
# /metrics on TASKFORGE_HTTP_ADDR above); set it to an empty string to
# disable it. TASKFORGE_ACTIVE_WORKER_WINDOW bounds "recent" for the
# taskforge_active_workers gauge -- see docs/observability.md.
TASKFORGE_METRICS_ADDR=:9090
TASKFORGE_ACTIVE_WORKER_WINDOW=30s

# Phase 12 (security). REQUIRED by cmd/api and cmd/taskforge-admin; not used
# by cmd/worker (a worker's identity is its PostgreSQL role, not an API
# credential -- see docs/security-model.md).
#
# This is the server-held HMAC pepper every API-key secret is hashed under.
# Generate it randomly, at least 32 bytes, and treat it exactly like a
# database password: never commit it, never log it, never put it in an image.
#
#   openssl rand -base64 48
#
# The SAME value must be given to cmd/api and to cmd/taskforge-admin -- a key
# minted under one pepper can never authenticate against a server running
# with another. Losing it invalidates every stored key and requires reissuing
# all of them; rotating it requires reissuing all of them too. There is no
# "authentication disabled" mode: cmd/api refuses to start without this.
TASKFORGE_API_KEY_PEPPER=replace-me-with-at-least-32-random-bytes

# Deployment boundaries this file cannot enforce, stated so they are not
# forgotten (docs/security-model.md, docs/phase-12-plan.md OD-7):
#
#   * TaskForge terminates NO TLS. Put a reverse proxy or load balancer in
#     front of cmd/api for any deployment reachable by an untrusted network,
#     and keep the proxy-to-TaskForge segment private. TaskForge trusts no
#     forwarded header (X-Forwarded-For and friends) for any security
#     decision.
#   * For the enterprise reference deployment, TASKFORGE_DATABASE_URL must
#     use sslmode=verify-full -- not sslmode=require, which encrypts but does
#     not verify the server's identity. The sslmode=disable default above is
#     a local-development value only.
#   * For least-privilege database roles, see deploy/postgres-roles.sql and
#     point cmd/api at taskforge_api, cmd/worker at taskforge_worker. Both
#     start normally under those roles against an already-migrated database;
#     applying a pending migration is a separate, owner-privileged step.
#   * TASKFORGE_METRICS_ADDR above is cmd/worker's metrics listener and is
#     NOT authenticated -- it cannot be, because authenticating it would
#     require the worker to read the credential tables, which the worker
#     trust boundary forbids. Bind or firewall it to a private network
#     reachable only by your Prometheus scraper. Only cmd/api's GET /metrics
#     is credential-protected (it requires the 'metrics' scope).
